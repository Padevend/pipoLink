generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// enum 
enum ChatType {
  private
  group
}

enum ConversationMemberRole {
  admin
  member
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  MIXED
  SYSTEM
}

// model
model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String?  @unique
  password      String
  username      String?
  matricule     String?
  role          String   @default("student")
  is_active     Boolean  @default(false)
  is_excluded   Boolean  @default(false)
  is_configured Boolean  @default(false)
  status        String   @default("ACTIVE")
  isAnonymized  Boolean  @default(false)
  deletedAt     DateTime? @db.Timestamptz
  anonymizedAt  DateTime? @db.Timestamptz
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  profile       UserProfile?
  subscription  Subscription?
  devices       Device[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  qrTokens      QrToken[]
  messages      Message[]
  memberships   ConversationMember[]
  chatsCreated  Chat[]               @relation("ChatCreatedBy")
  otps          Otp[]
  documents     Document[]           @relation("UserDocuments")
  aiSessions    AiSession[]
  payments      Payment[]
  notifications Notification[]
  announcements Announcement[]
  createdInvitations GroupInvitation[] @relation("CreatedInvitations")

  @@map("users")
}

model UserProfile {
  id        String  @id @default(uuid()) @db.Uuid
  user_id   String  @unique @db.Uuid
  firstname String
  lastname  String
  phone     String?
  gender    String?
  niveau    String?
  filiere   String?
  bio       String?
  avatarUrl String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model QrToken {
  id        String    @id @default(uuid()) @db.Uuid
  user_id   String    @db.Uuid
  token     String    @unique
  expiresAt DateTime  @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("qr_tokens")
}

model Device {
  id            String    @id @default(uuid()) @db.Uuid
  user_id       String    @db.Uuid
  name          String
  platform      String
  fingerprint   String
  isPrimary     Boolean   @default(false)
  public_key    String?
  key_signature String?
  keyCreatedAt  DateTime? @db.Timestamptz
  keyExpiresAt  DateTime? @db.Timestamptz
  fcm_token     String?
  revokedAt     DateTime? @db.Timestamptz
  lastActiveAt  DateTime  @default(now()) @db.Timestamptz
  createdAt     DateTime  @default(now()) @db.Timestamptz

  user           User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  tokens         RefreshToken[]
  chatMemberKeys ChatMemberKey[]

  @@map("devices")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  user_id   String    @db.Uuid
  device_id String?   @db.Uuid
  tokenHash String    @unique
  revokedAt DateTime? @db.Timestamptz
  expiresAt DateTime  @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  user   User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [device_id], references: [id], onDelete: SetNull)

  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  user_id   String   @db.Uuid
  action    String
  targetId  String?
  ip        String?
  userAgent String?
  location  String?
  createdAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model Chat {
  id            String   @id @default(uuid()) @db.Uuid
  type          ChatType @default(private)
  name          String?
  created_by_id String?  @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  createdBy  User?                @relation("ChatCreatedBy", fields: [created_by_id], references: [id], onDelete: SetNull)
  messages   Message[]
  members    ConversationMember[]
  memberKeys ChatMemberKey[]
  invitations GroupInvitation[]

  @@map("chats")
}

model ConversationMember {
  id              String                 @id @default(uuid()) @db.Uuid
  user_id         String                 @db.Uuid
  conversation_id String                 @db.Uuid
  role            ConversationMemberRole @default(member)
  lastReadAt      DateTime?              @db.Timestamptz

  user         User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  conversation Chat @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@unique([user_id, conversation_id])
  @@map("conversation_members")
}

model ChatMemberKey {
  id                 String   @id @default(uuid()) @db.Uuid
  chat_id            String   @db.Uuid
  device_id          String   @db.Uuid
  encrypted_chat_key String
  created_at         DateTime @default(now()) @db.Timestamptz
  updated_at         DateTime @updatedAt @db.Timestamptz

  chat   Chat   @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  device Device @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@unique([chat_id, device_id])
  @@index([chat_id])
  @@index([device_id])
  @@map("chat_member_keys")
}

model Message {
  id          String      @id @default(uuid()) @db.Uuid
  chat_id     String      @db.Uuid
  sender_id   String      @db.Uuid
  response_to String?     @db.Uuid
  cipherText  String
  iv          String
  status      String      @default("send")
  type        MessageType @default(TEXT)
  editedAt    DateTime?   @db.Timestamptz
  deletedAt   DateTime?   @db.Timestamptz
  created_at  DateTime    @default(now()) @db.Timestamptz

  chat        Chat                @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  sender      User                @relation(fields: [sender_id], references: [id], onDelete: Cascade)
  attachments MessageAttachment[]
  responseTo  Message?            @relation("MessageResponse", fields: [response_to], references: [id], onDelete: SetNull)
  responses   Message[]           @relation("MessageResponse")

  @@index([chat_id, created_at(sort: Desc)])
  @@map("messages")
}

model MessageAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  message_id String   @db.Uuid
  file_url   String
  iv         String
  file_name  String
  file_size  Int
  mime_type  String
  created_at DateTime @default(now()) @db.Timestamptz

  message Message @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@index([message_id])
  @@map("message_attachments")
}

model Subscription {
  id               String    @id @default(uuid()) @db.Uuid
  user_id          String    @unique @db.Uuid
  plan             String    @default("free")
  status           String    @default("active")
  currentPeriodEnd DateTime? @db.Timestamptz
  createdAt        DateTime  @default(now()) @db.Timestamptz
  updatedAt        DateTime  @updatedAt @db.Timestamptz

  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  payments Payment[]

  @@map("subscriptions")
}

model Folder {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  owner_id  String   @db.Uuid
  parent_id String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz

  @@map("folders")
}

model Document {
  id               String   @id @default(uuid()) @db.Uuid
  title            String
  description      String?
  niveau           String?
  filiere          String?
  ue               String?
  type             String   @default("AUTRE")
  year             Int?
  fileUrl          String
  fileName         String
  fileSize         Int
  mimeType         String
  isPublic         Boolean  @default(true)
  moderationStatus String   @default("PENDING")
  rejectionReason  String?
  downloadCount    Int      @default(0)
  folder_id        String?  @db.Uuid
  uploaded_by_id   String   @db.Uuid
  hash             String?
  createdAt        DateTime @default(now()) @db.Timestamptz

  uploadedBy User  @relation("UserDocuments", fields: [uploaded_by_id], references: [id], onDelete: Cascade)
  tags       Tag[] @relation("DocumentTags")
  aiSessions AiSession[] @relation("AiSessionDocuments")

  @@index([niveau, filiere, ue])
  @@index([downloadCount(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("documents")
}

model Tag {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  documents Document[] @relation("DocumentTags")

  @@map("tags")
}

model Download {
  id          String   @id @default(uuid()) @db.Uuid
  document_id String   @db.Uuid
  user_id     String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz

  @@map("downloads")
}

model Otp {
  id        String    @id @default(uuid()) @db.Uuid
  user_id   String    @db.Uuid
  code      String
  purpose   String
  attempts  Int       @default(0)
  expiresAt DateTime  @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("otps")
}

model AiSession {
  id        String   @id @default(uuid()) @db.Uuid
  user_id   String   @db.Uuid
  title     String
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  user      User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  messages  AiMessage[]
  documents Document[]  @relation("AiSessionDocuments")

  @@map("ai_sessions")
}

model AiMessage {
  id         String   @id @default(uuid()) @db.Uuid
  session_id String   @db.Uuid
  role       String
  content    String
  createdAt  DateTime @default(now()) @db.Timestamptz

  session AiSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@map("ai_messages")
}

model Payment {
  id              String    @id @default(uuid()) @db.Uuid
  user_id         String    @db.Uuid
  subscription_id String    @db.Uuid
  amount          Float
  currency        String    @default("XAF")
  status          String    @default("PENDING")
  provider        String
  providerRef     String?
  paidAt          DateTime? @db.Timestamptz
  expiresAt       DateTime  @db.Timestamptz
  createdAt       DateTime  @default(now()) @db.Timestamptz

  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  user_id   String   @db.Uuid
  title     String
  body      String
  type      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Announcement {
  id         String   @id @default(uuid()) @db.Uuid
  title      String
  content    String
  poster     String?
  previewUrl String?
  author_id  String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  author User @relation(fields: [author_id], references: [id], onDelete: Cascade)

  @@map("announcements")
}

model GroupInvitation {
  id                 String   @id @default(uuid()) @db.Uuid
  chat_id            String   @db.Uuid
  token              String   @unique
  encrypted_chat_key String?
  max_uses           Int?
  uses               Int      @default(0)
  expires_at         DateTime? @db.Timestamptz
  revoked_at         DateTime? @db.Timestamptz
  created_by_id      String   @db.Uuid
  created_at         DateTime @default(now()) @db.Timestamptz

  chat            Chat     @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  createdBy       User     @relation("CreatedInvitations", fields: [created_by_id], references: [id], onDelete: Cascade)

  @@map("group_invitations")
}
